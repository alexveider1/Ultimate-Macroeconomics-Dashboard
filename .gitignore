# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
dist/
wheels/
pip-wheel-metadata/
.eggs/

# Virtual environments
venv/
venv*/
.venv/
.venv*/
env/
ENV/

# Jupyter / notebooks
.ipynb_checkpoints/
*.ipynb_backup

# Tooling caches
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ty_cache/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---------------------------------------------------------------------------
# Tests (negation — keep tests/ dirs but ignore generic test*/ scratch dirs)
# ---------------------------------------------------------------------------
test/
test*/
!tests/
!**/tests/

# ---------------------------------------------------------------------------
# Project runtime / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Ingested data + ingestion marker (re-created on first boot)
/_container_data/downloader_general/news
/_container_data/downloader_general/.download_completed

# Cloud backups: rclone remote secrets + local staging/restore artifacts
# (rclone.conf.example IS committed; the real rclone.conf holds credentials)
/_container_data/backup/rclone.conf
/_container_data/backup/staging/
/_container_data/backup/restore/
*.dump
*.snapshot

# Per-service local-dev config.yaml stubs. The single source of truth is
# _container_data/config.yaml, bind-mounted read-only into every container at
# /app/config.yaml; these tiny per-service copies only let a service boot
# standalone outside Docker and are auto-created by each service's
# tests/conftest.py. Kept untracked so they can never drift from the real file.
# (Root-anchored so _container_data/config.yaml is never matched.)
/forecaster/config.yaml
/clustering/config.yaml
/python_sandbox/config.yaml

# Logs
logs/
*.log
*.log.*

# SQL dumps
*.sql

# ---------------------------------------------------------------------------
# IDEs / editors
# ---------------------------------------------------------------------------
*.swp
*.swo
*~

# Local Claude Code state
.claude/settings.local.json

