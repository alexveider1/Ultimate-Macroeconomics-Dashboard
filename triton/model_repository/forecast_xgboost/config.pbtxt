name: "forecast_xgboost"
backend: "python"
max_batch_size: 0

input [
  {
    name: "INPUT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "OUTPUT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

# XGBoost trains + predicts on the GPU (device="cuda") pinned by KIND_GPU.
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
